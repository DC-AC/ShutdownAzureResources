{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.36.177.2456",
      "templateHash": "205408063668293474"
    },
    "description": "Refreshes the runbook script and its Az modules on an Automation account that already\nexists. Touches nothing else: identity, schedules, and role assignments are left as they\nare. Use this for routine version bumps; use main.bicep for a first deployment.\n"
  },
  "parameters": {
    "automationAccountName": {
      "type": "string",
      "minLength": 6,
      "maxLength": 50,
      "metadata": {
        "description": "Name of the existing Azure Automation account."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region of the existing Automation account. Defaults to the resource group location."
      }
    },
    "runbookName": {
      "type": "string",
      "defaultValue": "ShutdownAzureResources",
      "metadata": {
        "description": "Name of the runbook to refresh."
      }
    },
    "runbookScriptUri": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/DC-AC/ShutdownAzureResources/master/Runbook.ps1",
      "metadata": {
        "description": "URI the runbook content is published from."
      }
    },
    "runbookContentVersion": {
      "type": "string",
      "defaultValue": "2.0.0.0",
      "metadata": {
        "description": "Content version stamped on the runbook. This must change for Azure Automation\nto re-fetch the script, so bump it on every upgrade."
      }
    },
    "logVerbose": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Write verbose streams to the job log."
      }
    },
    "logProgress": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Write progress records to the job log."
      }
    },
    "powerShellModules": {
      "type": "array",
      "defaultValue": [
        {
          "name": "Az.Accounts",
          "version": "5.5.2"
        },
        {
          "name": "Az.Resources",
          "version": "10.1.0"
        },
        {
          "name": "Az.Compute",
          "version": "11.8.0"
        },
        {
          "name": "Az.Sql",
          "version": "7.0.0"
        },
        {
          "name": "Az.Network",
          "version": "8.1.0"
        },
        {
          "name": "Az.Storage",
          "version": "9.7.2"
        },
        {
          "name": "Az.Monitor",
          "version": "8.0.0"
        },
        {
          "name": "Az.Websites",
          "version": "4.0.0"
        },
        {
          "name": "Az.Aks",
          "version": "7.2.1"
        },
        {
          "name": "Az.ContainerInstance",
          "version": "5.0.0"
        },
        {
          "name": "Az.Synapse",
          "version": "3.3.0"
        }
      ],
      "metadata": {
        "description": "Az modules to re-import, as objects of the shape\n{ name: 'Az.Compute', version: '11.8.0' }. Leave a version empty to pull the latest from the\nPowerShell Gallery; pin it for reproducible deployments."
      }
    }
  },
  "variables": {
    "orderedModules": "[concat(filter(parameters('powerShellModules'), lambda('m', equals(lambdaVariables('m').name, 'Az.Accounts'))), filter(parameters('powerShellModules'), lambda('m', not(equals(lambdaVariables('m').name, 'Az.Accounts')))))]",
    "galleryRoot": "https://www.powershellgallery.com/api/v2/package"
  },
  "resources": [
    {
      "copy": {
        "name": "azModules",
        "count": "[length(variables('orderedModules'))]",
        "mode": "serial",
        "batchSize": 1
      },
      "type": "Microsoft.Automation/automationAccounts/powerShell72Modules",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}/{1}', parameters('automationAccountName'), variables('orderedModules')[copyIndex()].name)]",
      "properties": {
        "contentLink": {
          "uri": "[if(empty(variables('orderedModules')[copyIndex()].version), format('{0}/{1}', variables('galleryRoot'), variables('orderedModules')[copyIndex()].name), format('{0}/{1}/{2}', variables('galleryRoot'), variables('orderedModules')[copyIndex()].name, variables('orderedModules')[copyIndex()].version))]",
          "version": "[if(empty(variables('orderedModules')[copyIndex()].version), null(), variables('orderedModules')[copyIndex()].version)]"
        }
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/runbooks",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}/{1}', parameters('automationAccountName'), parameters('runbookName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "runbookType": "PowerShell72",
        "logProgress": "[parameters('logProgress')]",
        "logVerbose": "[parameters('logVerbose')]",
        "description": "Automatically shut down, scale down, and clean up non-production Azure resources.",
        "publishContentLink": {
          "uri": "[parameters('runbookScriptUri')]",
          "version": "[parameters('runbookContentVersion')]"
        }
      }
    }
  ],
  "outputs": {
    "runbookName": {
      "type": "string",
      "metadata": {
        "description": "Name of the refreshed runbook."
      },
      "value": "[parameters('runbookName')]"
    },
    "runbookContentVersion": {
      "type": "string",
      "metadata": {
        "description": "Content version now published."
      },
      "value": "[parameters('runbookContentVersion')]"
    }
  }
}